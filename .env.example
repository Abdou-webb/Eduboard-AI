# Groq (gratuit, modeles open source) : si GROQ_API_KEY est presente, Groq est utilise
GROQ_API_KEY=gsk_...
# GROQ_MODEL=qwen/qwen3.8-27b

# ou Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# EDUBOARD_PROVIDER=anthropic
# EDUBOARD_MODEL=claude-opus-5-5

# optionnel
EDUBOARD_EFFORT=medium
EDUBOARD_MAX_STEPS=12
EDUBOARD_FALLBACK=1
EDUBOARD_MAX_IMAGES=5
